---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }} - Todos los Contenidos</title>
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/" rel="alternate" type="text/html"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}/</id>
  <author>
    <name>{{ site.author }}</name>
  </author>
  <subtitle>{{ site.description }}</subtitle>

  {% comment %}
  Combinar posts y releases en un solo array y ordenar por fecha
  {% endcomment %}
  {% assign all_items = site.posts | concat: site.releases | sort: 'date' | reverse %}

  {% for item in all_items limit:20 %}
  <entry>
    <title>{{ item.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ item.url }}" rel="alternate" type="text/html"/>
    <published>{{ item.date | date_to_xmlschema }}</published>
    <updated>{{ item.date | date_to_xmlschema }}</updated>
    <id>{{ site.url }}{{ item.id }}</id>
    <content type="html" xml:base="{{ site.url }}{{ item.url }}">
      {{ item.content | xml_escape }}
    </content>
    {% if item.collection == 'releases' %}
    <category term="release"/>
    {% else %}
    <category term="post"/>
    {% endif %}
  </entry>
  {% endfor %}
</feed>
